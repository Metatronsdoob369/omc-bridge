# OMC Bridge — environment variables
# Copy to .env and fill in values before starting the server.

# Server port (default: 3099)
PORT=3099

# Path to the audit log file (JSONL, append-only)
# Default: ./bridge.log in the repo root
OMC_AUDIT_LOG=./bridge.log

# Qdrant vector store URL (used by governance gate)
# Set to empty string to disable vector store integration
QDRANT_URL=http://127.0.0.1:6333

# Optional: shared secret for submit auth
# OMC_SUBMIT_SECRET=changeme
